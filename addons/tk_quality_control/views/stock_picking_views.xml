<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_tk_quality" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.tk_quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_tk_view_quality_checks" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" invisible="not tk_quality_check_count">
                    <field name="tk_quality_check_count" widget="statinfo" string="Quality Checks"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="tk_quality_state" invisible="1"/>
                <div class="alert alert-warning mb-0 text-center" role="alert"
                     invisible="tk_quality_state != 'pending' or state in ('done', 'cancel')">
                    This transfer has quality checks to do before it can be validated.
                </div>
                <div class="alert alert-danger mb-0 text-center" role="alert"
                     invisible="tk_quality_state != 'fail'">
                    At least one quality check failed on this transfer.
                </div>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_inherit_tk_quality" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.tk_quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="tk_quality_state" optional="show" widget="badge"
                       decoration-info="tk_quality_state == 'pending'"
                       decoration-danger="tk_quality_state == 'fail'"
                       decoration-success="tk_quality_state == 'pass'"
                       invisible="tk_quality_state == 'none'"/>
            </field>
        </field>
    </record>
</odoo>
