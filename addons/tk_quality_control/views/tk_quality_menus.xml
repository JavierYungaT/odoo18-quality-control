<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_tk_quality_dashboard" model="ir.actions.client">
        <field name="name">Quality Overview</field>
        <field name="tag">tk_quality_control.dashboard</field>
    </record>

    <menuitem id="menu_tk_quality_root"
              name="Quality"
              web_icon="tk_quality_control,static/description/icon.png"
              groups="group_quality_user"
              sequence="38"/>

    <menuitem id="menu_tk_quality_dashboard" name="Overview" parent="menu_tk_quality_root"
              action="action_tk_quality_dashboard" sequence="1"/>

    <menuitem id="menu_tk_quality_control" name="Control" parent="menu_tk_quality_root" sequence="10">
        <menuitem id="menu_tk_quality_check" name="Quality Checks"
                  action="action_tk_quality_check" sequence="10"/>
        <menuitem id="menu_tk_quality_alert" name="Quality Alerts"
                  action="action_tk_quality_alert" sequence="20"/>
    </menuitem>

    <menuitem id="menu_tk_quality_reporting" name="Reporting" parent="menu_tk_quality_root" sequence="20">
        <menuitem id="menu_tk_quality_report" name="Quality Analysis"
                  action="action_tk_quality_report" sequence="10"/>
    </menuitem>

    <menuitem id="menu_tk_quality_config" name="Configuration" parent="menu_tk_quality_root"
              groups="group_quality_manager" sequence="100">
        <menuitem id="menu_tk_quality_settings" name="Settings"
                  action="action_tk_quality_config_settings" sequence="1"/>
        <menuitem id="menu_tk_quality_point" name="Control Points"
                  action="action_tk_quality_point" sequence="10"/>
        <menuitem id="menu_tk_quality_alert_stage" name="Alert Stages"
                  action="action_tk_quality_alert_stage" sequence="20"/>
    </menuitem>
</odoo>
