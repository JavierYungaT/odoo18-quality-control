<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_tk_quality" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.tk_quality</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="tk_show_quality_warning" invisible="1"/>
                <div class="alert alert-warning mb-0 text-center" role="alert"
                     invisible="not tk_show_quality_warning">
                    This vendor's quality score is
                    <strong><field name="supplier_quality_score" class="oe_inline"/> %</strong>,
                    below the minimum defined in the Quality settings.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="supplier_quality_check_count" invisible="1"/>
                <label for="supplier_quality_score" string="Vendor Quality"
                       invisible="not supplier_quality_check_count"/>
                <div invisible="not supplier_quality_check_count">
                    <field name="supplier_quality_score" class="oe_inline"/> %
                </div>
            </xpath>
        </field>
    </record>
</odoo>
