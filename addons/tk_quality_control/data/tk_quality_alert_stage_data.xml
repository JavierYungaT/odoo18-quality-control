<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_new" model="tk.quality.alert.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_analysis" model="tk.quality.alert.stage">
            <field name="name">Root Cause Analysis</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_action" model="tk.quality.alert.stage">
            <field name="name">Corrective Action</field>
            <field name="sequence">30</field>
        </record>
        <record id="stage_closed" model="tk.quality.alert.stage">
            <field name="name">Closed</field>
            <field name="sequence">40</field>
            <field name="fold" eval="True"/>
            <field name="is_closed" eval="True"/>
        </record>
    </data>
</odoo>
